            "\n",
            "===== BIBLIOTECA =====\n",
            "\n",
            "1 - Cadastrar livro\n",
            "2 - Listar livros\n",
            "3 - Pesquisar livro\n",
            "4 - Remover livro\n",
            "5 - Emprestar livro\n",
            "6 - Devolver livro\n",
            "7 - Sair\n",
            "\n",
            "======================\n",
            "\n"
          ]
        }
      ],
      "source": [
        "import json\n",
        "import os\n",
        "\n",
        "\n",
        "livros = []\n",
        "arquivo = \"biblioteca.json\"\n",
        "\n",
        "\n",
        "def salvar_dados():\n",
        "    with open(arquivo, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(livros, f, indent=4, ensure_ascii=False)\n",
        "\n",
        "\n",
        "def carregar_dados():\n",
        "    if os.path.exists(arquivo):\n",
        "        with open(arquivo, \"r\", encoding=\"utf-8\") as f:\n",
        "            dados = json.load(f)\n",
        "            livros.extend(dados)\n",
        "\n",
        "\n",
        "\n",
        "def validar_nome(nome):\n",
        "    if nome == \"\":\n",
        "        print(\"Campo obrigatório.\")\n",
        "        return False\n",
        "\n",
        "    if not nome.replace(\" \", \"\").isalpha():\n",
        "        print(\"Digite apenas letras e espaços.\")\n",
        "        return False\n",
        "\n",
        "    return True\n",
        "\n",
        "\n",
        "\n",
        "def livro_existe(nome):\n",
        "    for livro in livros:\n",
        "        if livro[\"Livro\"].lower() == nome.lower():\n",
        "            return True\n",
        "\n",
        "    return False\n",
        "\n",
        "\n",
        "\n",
        "def buscar_livro(nome):\n",
        "    for livro in livros:\n",
        "        if livro[\"Livro\"].lower() == nome.lower():\n",
        "            return livro\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "\n",
        "def mostrar_livro(livro):\n",
        "    print(\"----------------------\")\n",
        "    print(f\"Livro: {livro['Livro']}\")\n",
        "    print(f\"Autor: {livro['Autor']}\")\n",
        "\n",
        "    if livro[\"Disponivel\"]:\n",
        "        print(\"Status: Disponível\")\n",
        "    else:\n",
        "        print(\"Status: Emprestado\")\n",
        "        print(f\"Com: {livro['Emprestado_para']}\")\n",
        "\n",
        "    print(\"----------------------\")\n",
        "\n",
        "\n",
        "\n",
        "def cadastrar_livro():\n",
        "\n",
        "    nome_livro = input(\"Digite o nome do livro: \").strip()\n",
        "\n",
        "    if not validar_nome(nome_livro):\n",
        "        return\n",
        "\n",
        "\n",
        "    if livro_existe(nome_livro):\n",
        "        print(\"Esse livro já está cadastrado.\")\n",
        "        return\n",
        "\n",
        "\n",
        "    nome_autor = input(\"Digite o nome do autor: \").strip()\n",
        "\n",
        "    if not validar_nome(nome_autor):\n",
        "        return\n",
        "\n",
        "\n",
        "    livros.append({\n",
        "        \"Livro\": nome_livro,\n",
        "        \"Autor\": nome_autor,\n",
        "        \"Disponivel\": True,\n",
        "        \"Emprestado_para\": None\n",
        "    })\n",
        "\n",
        "\n",
        "    salvar_dados()\n",
        "\n",
        "    print(\"Livro cadastrado com sucesso!\")\n",
        "\n",
        "\n",
        "\n",
        "def listar_livros():\n",
        "\n",
        "    if not livros:\n",
        "        print(\"Nenhum livro cadastrado.\")\n",
        "        return\n",
        "\n",
        "\n",
        "    for livro in livros:\n",
        "        mostrar_livro(livro)\n",
        "\n",
        "\n",
        "\n",
        "def pesquisar_livro():\n",
        "\n",
        "    nome = input(\"Digite o nome do livro: \").strip()\n",
        "\n",
        "    livro = buscar_livro(nome)\n",
        "\n",
        "\n",
        "    if livro:\n",
        "        mostrar_livro(livro)\n",
        "\n",
        "    else:\n",
        "        print(\"Livro não encontrado.\")\n",
        "\n",
        "\n",
        "\n",
        "def emprestar_livro():\n",
        "\n",
        "    nome = input(\"Digite o nome do livro: \").strip()\n",
        "\n",
        "    livro = buscar_livro(nome)\n",
        "\n",
        "\n",
        "    if livro is None:\n",
        "        print(\"Livro não encontrado.\")\n",
        "        return\n",
        "\n",
        "\n",
        "    if not livro[\"Disponivel\"]:\n",
        "        print(\"Esse livro já está emprestado.\")\n",
        "        print(f\"Está com: {livro['Emprestado_para']}\")\n",
        "        return\n",
        "\n",
        "\n",
        "    pessoa = input(\"Nome de quem vai pegar o livro: \").strip()\n",
        "\n",
        "\n",
        "    if not validar_nome(pessoa):\n",
        "        return\n",
        "\n",
        "\n",
        "    livro[\"Disponivel\"] = False\n",
        "    livro[\"Emprestado_para\"] = pessoa\n",
        "\n",
        "\n",
        "    salvar_dados()\n",
        "\n",
        "    print(\"Livro emprestado com sucesso!\")\n",
        "\n",
        "\n",
        "\n",
        "def devolver_livro():\n",
        "\n",
        "    nome = input(\"Digite o nome do livro: \").strip()\n",
        "\n",
        "    livro = buscar_livro(nome)\n",
        "\n",
        "\n",
        "    if livro is None:\n",
        "        print(\"Livro não encontrado.\")\n",
        "        return\n",
        "\n",
        "\n",
        "    if livro[\"Disponivel\"]:\n",
        "        print(\"Esse livro já está disponível.\")\n",
        "        return\n",
        "\n",
        "\n",
        "    livro[\"Disponivel\"] = True\n",
        "    livro[\"Emprestado_para\"] = None\n",
        "\n",
        "\n",
        "    salvar_dados()\n",
        "\n",
        "    print(\"Livro devolvido com sucesso!\")\n",
        "\n",
        "\n",
        "\n",
        "def remover_livro():\n",
        "\n",
        "    nome = input(\"Digite o nome do livro: \").strip()\n",
        "\n",
        "    livro = buscar_livro(nome)\n",
        "\n",
        "\n",
        "    if livro:\n",
        "\n",
        "        livros.remove(livro)\n",
        "\n",
        "        salvar_dados()\n",
        "\n",
        "        print(\"Livro removido com sucesso.\")\n",
        "\n",
        "    else:\n",
        "        print(\"Livro não encontrado.\")\n",
        "\n",
        "\n",
        "\n",
        "def menu():\n",
        "\n",
        "    while True:\n",
        "\n",
        "        print(\"\"\"\n",
        "===== BIBLIOTECA =====\n",
        "\n",
        "1 - Cadastrar livro\n",
        "2 - Listar livros\n",
        "3 - Pesquisar livro\n",
        "4 - Remover livro\n",
        "5 - Emprestar livro\n",
        "6 - Devolver livro\n",
        "7 - Sair\n",
        "\n",
        "======================\n",
        "\"\"\")\n",
        "\n",
        "\n",
        "        try:\n",
        "            escolha = int(input(\"Escolha uma opção: \"))\n",
        "\n",
        "        except ValueError:\n",
        "            print(\"Digite apenas números.\")\n",
        "            continue\n",
        "\n",
        "\n",
        "\n",
        "        match escolha:\n",
        "\n",
        "            case 1:\n",
        "                cadastrar_livro()\n",
        "\n",
        "            case 2:\n",
        "                listar_livros()\n",
        "\n",
        "            case 3:\n",
        "                pesquisar_livro()\n",
        "\n",
        "            case 4:\n",
        "                remover_livro()\n",
        "\n",
        "            case 5:\n",
        "                emprestar_livro()\n",
        "\n",
        "            case 6:\n",
        "                devolver_livro()\n",
        "\n",
        "            case 7:\n",
        "                print(\"Programa encerrado.\")\n",
        "                break\n",
        "\n",
        "            case _:\n",
        "                print(\"Opção inválida.\")\n",
        "\n",
        "\n",
        "\n",
        "carregar_dados()\n",
        "menu()"
      ]
