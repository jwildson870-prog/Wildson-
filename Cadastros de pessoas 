        "cadastros = {}\n",
        "\n",
        "\n",
        "def novocadastro():\n",
        "    nome = input(\"Digite seu nome: \").strip()\n",
        "\n",
        "    if not nome.replace(\" \", \"\").isalpha():\n",
        "        print(\"Digite apenas letras no nome!\")\n",
        "        return\n",
        "\n",
        "    if nome in cadastros:\n",
        "        print(\"Já existe um cadastro com esse nome.\")\n",
        "        return\n",
        "\n",
        "    telefone = input(\"Digite seu número de telefone: \")\n",
        "\n",
        "    if not telefone.isdigit():\n",
        "        print(\"Digite apenas números no telefone!\")\n",
        "        return\n",
        "\n",
        "    if telefone in cadastros.values():\n",
        "        print(\"Esse número de telefone já foi cadastrado.\")\n",
        "        return\n",
        "\n",
        "    cadastros[nome] = telefone\n",
        "\n",
        "    print(\"Cadastro realizado com sucesso!\")\n",
        "\n",
        "\n",
        "def removercadastro():\n",
        "    if not cadastros:\n",
        "        print(\"Nenhum cadastro até o momento.\")\n",
        "        return\n",
        "\n",
        "    nome = input(\"Qual o nome da pessoa: \")\n",
        "\n",
        "    if nome in cadastros:\n",
        "        del cadastros[nome]\n",
        "        print(\"Cadastro removido com sucesso!!!\")\n",
        "    else:\n",
        "        print(\"Esse nome não está cadastrado.\")\n",
        "\n",
        "\n",
        "def verlista():\n",
        "    if not cadastros:\n",
        "        print(\"Nenhum cadastro até o momento.\")\n",
        "        return\n",
        "\n",
        "    for nome, telefone in cadastros.items():\n",
        "        print(\"==========================\")\n",
        "        print(\"Cadastros até o momento\")\n",
        "        print(f\"Nome: {nome}\")\n",
        "        print(f\"Telefone: {telefone}\")\n",
        "        print(\"==========================\")\n",
        "\n",
        "\n",
        "def editarcadastro():\n",
        "    if not cadastros:\n",
        "        print(\"Nenhum cadastro até o momento.\")\n",
        "        return\n",
        "\n",
        "    nome_antigo = input(\"Qual cadastro você deseja editar: \")\n",
        "\n",
        "    if nome_antigo not in cadastros:\n",
        "        print(\"Esse nome não está cadastrado!\")\n",
        "        return\n",
        "\n",
        "    print(\"Opção de edição\")\n",
        "    print(\"1 - Nome\")\n",
        "    print(\"2 - Número\")\n",
        "    print(\"3 - As duas opções\")\n",
        "\n",
        "    escolha = int(input(\"O que você deseja editar: \"))\n",
        "\n",
        "\n",
        "    match escolha:\n",
        "\n",
        "        case 1:\n",
        "            novo_nome = input(\"Digite o novo nome: \").strip()\n",
        "\n",
        "            if not novo_nome.replace(\" \", \"\").isalpha():\n",
        "                print(\"Digite apenas letras no nome!\")\n",
        "                return\n",
        "\n",
        "            if novo_nome in cadastros:\n",
        "                print(\"Esse nome já está cadastrado!\")\n",
        "                return\n",
        "\n",
        "            telefone = cadastros[nome_antigo]\n",
        "\n",
        "            del cadastros[nome_antigo]\n",
        "            cadastros[novo_nome] = telefone\n",
        "\n",
        "            print(\"Nome atualizado com sucesso!\")\n",
        "\n",
        "\n",
        "        case 2:\n",
        "            novo_telefone = input(\"Digite o novo número: \")\n",
        "\n",
        "            if not novo_telefone.isdigit():\n",
        "                print(\"Digite apenas números no telefone!\")\n",
        "                return\n",
        "\n",
        "            if novo_telefone in cadastros.values():\n",
        "                print(\"Esse número já está cadastrado!\")\n",
        "                return\n",
        "\n",
        "            cadastros[nome_antigo] = novo_telefone\n",
        "\n",
        "            print(\"Número atualizado com sucesso!\")\n",
        "\n",
        "\n",
        "        case 3:\n",
        "            novo_nome = input(\"Digite o novo nome: \").strip()\n",
        "\n",
        "            if not novo_nome.replace(\" \", \"\").isalpha():\n",
        "                print(\"Digite apenas letras no nome!\")\n",
        "                return\n",
        "\n",
        "            novo_telefone = input(\"Digite o novo número: \")\n",
        "\n",
        "            if not novo_telefone.isdigit():\n",
        "                print(\"Digite apenas números no telefone!\")\n",
        "                return\n",
        "\n",
        "            if novo_nome in cadastros or novo_telefone in cadastros.values():\n",
        "                print(\"Nome ou telefone já cadastrado!\")\n",
        "                return\n",
        "\n",
        "            del cadastros[nome_antigo]\n",
        "            cadastros[novo_nome] = novo_telefone\n",
        "\n",
        "            print(\"Cadastro atualizado com sucesso!\")\n",
        "\n",
        "\n",
        "        case _:\n",
        "            print(\"Opção inválida!\")\n",
        "\n",
