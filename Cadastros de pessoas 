        "    if not cadastros:\n",
        "        print(\"Nenhum cadastro até o momento.\")\n",
        "        return\n",
        "\n",
        "    nome = input(\"Digite o nome que deseja pesquisar: \")\n",
        "\n",
        "    if nome in cadastros:\n",
        "        print(\"==========================\")\n",
        "        print(\"Cadastro encontrado!\")\n",
        "        print(f\"Nome: {nome}\")\n",
        "        print(f\"Telefone: {cadastros[nome]}\")\n",
        "        print(\"==========================\")\n",
        "    else:\n",
